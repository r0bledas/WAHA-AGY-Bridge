# WAHA Configuration
WHATSAPP_API_PORT=3000
WHATSAPP_DEFAULT_ENGINE=WEBJS
WAHA_PRINT_QR=True
WAHA_LOG_FORMAT=PRETTY
WAHA_LOG_LEVEL=info

# Dashboard & API Credentials
WAHA_API_KEY=your_waha_api_key_here
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=your_dashboard_password_here
WHATSAPP_SWAGGER_USERNAME=admin
WHATSAPP_SWAGGER_PASSWORD=your_swagger_password_here

# Global Webhook Configuration for AGY Bridge
WHATSAPP_HOOK_URL=http://host.docker.internal:5055/webhook
WHATSAPP_HOOK_EVENTS=message,message.any

# AGY Bridge Security & Self-Chat Configuration
BRIDGE_PORT=5055
BRIDGE_PASSPHRASE=your_secret_passphrase_here
BRIDGE_MY_ACCOUNTS=1234567890@c.us,1234567890@lid
AGY_DIR=C:\path\to\AGY-Portable

# ?????? Multi-agent routing (manual cycling; no auto router) ??????
DEFAULT_AGENT=agy
AGY_COOLDOWN_DEFAULT_HOURS=24
AGY_INACTIVITY_TIMEOUT_SECONDS=600
AGY_MAX_PROMPT_TIMEOUT_SECONDS=1800
AGY_TOOL_TIMEOUT_SECONDS=1800

# ?????? Hermes (DeepSeek) backend ??????
HERMES_ENABLED=true
HERMES_PROFILE=wa
HERMES_MODEL=
HERMES_WORKDIR=C:\waha\workspace
HERMES_IDLE_TIMEOUT_SECONDS=900
HERMES_MAX_RUNTIME_SECONDS=1800
HERMES_STREAM_TEXT=true
HERMES_STREAM_MIN_CHARS=400
HERMES_STREAM_DEBOUNCE_SECONDS=2.5
HERMES_GEMINI_SOURCE=C:\waha\GEMINI.md
HERMES_SKILLS_SOURCE=C:\waha\.agents\skills
HERMES_COOLDOWN_DEFAULT_MINUTES=30
